# Copy to .env for local use (.env is gitignored and excluded from the Docker image).
# In production set these as Railway variables instead.
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE-ME
APP_PASSWORD=choose-a-long-random-password
# Email results via Resend (sender domain must be verified in Resend)
RESEND_API_KEY=re_REPLACE-ME
RESEND_TO=Info@tencapital.group
RESEND_FROM=TEN Capital Ownership Calculator <ownership@tencapital.group>
# Optional
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high
CLAUDE_MAX_IMAGES=16
AI_REVIEW_DEFAULT=true
MAX_UPLOAD_MB=200
JOB_TTL_MINUTES=60
